# ==========================================
# SDMS Environment Configuration Template
# ==========================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real secrets to version control.

# Application Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma)
POSTGRES_USER=sdms_user
POSTGRES_PASSWORD=sdms_password
POSTGRES_DB=sdms_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sdms_user:sdms_password@localhost:5432/sdms_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Object Storage (S3-compatible)
# Note: Host port 9002 maps to container 9000 to avoid conflicting with existing services
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sdms-documents

# ClamAV Malware Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Security & Authentication (Argon2id & JWT)
# Minimum 32-character high-entropy random strings for production
JWT_SECRET=development-jwt-access-secret-replace-with-secure-key-in-prod-32c
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-jwt-refresh-secret-replace-with-secure-key-in-prod-32c
JWT_REFRESH_EXPIRES_IN=7d

# Export Package Signing (Ed25519) - Set up in Phase 7
EXPORT_SIGNING_PRIVATE_KEY=
EXPORT_SIGNING_PUBLIC_KEY=
